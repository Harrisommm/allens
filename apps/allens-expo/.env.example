# Copy to .env — never commit the filled-in file.
# Anything prefixed EXPO_PUBLIC_ is readable inside the shipped app bundle,
# so restrict these keys by API and by bundle id / SHA-1 in Google Cloud Console.

# Firebase web client id used for Google Sign-In (Firebase console > Authentication > Google).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Cloud Translation API key. Leave empty to skip translation —
# scans still work and are matched against the original label text.
EXPO_PUBLIC_GOOGLE_TRANSLATE_API_KEY=
